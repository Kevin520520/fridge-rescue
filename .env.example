# Copy the relevant values to .env and replace the selected provider's key locally.
# Never paste a real API key into chat or commit .env to version control.
# Agentic and baseline modes intentionally use the same active provider/model.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_with_your_own_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional OpenAI fallback: change LLM_PROVIDER=openai and set this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_BASE_URL=

# Photo recognition reuses the selected provider's API key and base URL.
# Default: deepseek-flash for DeepSeek, or OPENAI_MODEL for OpenAI.
# Optional override; the model must support image input and Structured Outputs.
VISION_MODEL=

# Corpus rebuilding does not need credentials. The downloader uses the public
# Epicurious CSV revision and SHA-256 pinned in the data pipeline.
